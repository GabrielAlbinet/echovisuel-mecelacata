generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Artist {
  id          Int    @id @default(autoincrement())
  name        String
  category    String
  image       String
  description String
}

model Venue {
  id          Int     @id @default(autoincrement())
  name        String
  type        String
  description String?
  capacity    Int
  location    String
  image       String
}

model Ticket {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       Float
  quantity    Int
  condition   String
  available   Boolean
}