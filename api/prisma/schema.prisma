generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Artist {
  id          Int     @id @default(autoincrement())
  name        String
  category    String
  image       String
  description String
  events      Event[]
}

model Venue {
  id          Int     @id @default(autoincrement())
  name        String
  type        String
  description String?
  capacity    Int
  location    String
  image       String
  events      Event[]
}

model Ticket {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       Float
  quantity    Int
  condition   String
  available   Boolean
}

enum EventStatus {
  scheduled
  cancelled
}

model Event {
  id        Int         @id @default(autoincrement())
  date      String      // "2026-08-21" (même format que le front)
  startTime String      // "20:00"
  endTime   String      // "21:30"
  status    EventStatus @default(scheduled)
  artistId  Int
  venueId   Int
  artist    Artist      @relation(fields: [artistId], references: [id])
  venue     Venue       @relation(fields: [venueId], references: [id])
}